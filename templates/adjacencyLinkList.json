{
  "pan": true, 
  "zoom": true,
  "data": "[dataDefinition]",
  "networks": "[networksDefinition]",
  "width": "[width]",
  "height": "[height]",
  "groupings": [
    {
      "name": "groupedBySource",
      "data": "network.links",
      "common": ["source.id"]
    }
  ],
  "parameters":[

    {
      "name": "hoveredNode",
      "network": "network",
      "type": "selection",
      "clearOnBackgroundClick": true
    },

    {
      "name": "labelSizeParam",
      "bind": {
        "input": "range",
        "event": "onChange",
        "label": "Label Size",
        "min": "5",
        "max": "25",
        "step": "1"
      },
      "value": 13
    },

    {
      "name": "adjacentLinkSize",
      "bind": {
        "input": "range",
        "event": "onChange",
        "label": "Adjacent Node Size",
        "min": "5",
        "max": "300",
        "step": "1"
      },
      "value": 80
    },
    {
      "name": "spacing",
      "bind": {
        "input": "range",
        "event": "onChange",
        "label": "Links Spacing",
        "min": "5",
        "max": "40",
        "step": "1"
      },
      "value": 10
    },

    {
      "name": "time",
      "bind": {
        "input": "brush",
        "axisType": "time",
        "network": "network",
        "for": "links",
        "field": "data._time"
      }
    }
  ],
  "orderings": [
    {
      "name": "order",
      "data": "groupedBySource",
      "orderBy": {
        "field": "size",
        "direction": "descending"
      }
    }
  ],
  "layouts": [
    {
      "name": "layout",
      "data": "groupedBySource",
      "pattern": "cartesian",
      "y": [
        {
          "order": "order"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "opacity",
      "type": "linear",
      "range": [
        0.2,
        1
      ],
      "domain": {
        "data": "network.links",
        "field": "linkWeight"
      }
    },
    {
      "name": "cellColor",
      "type": "ordinal",
      "range": "[colorScheme]",
      "domain": {
        "data": "network.links",
        "field": "linkType"
      }
    }
  ],
  "vis": [
    {
      "entries": "groupedBySource",
      "layout": "layout",

      "actions": [
        {
          "interaction": "select",
          "using": "cursor",
          "event": "mouseover",
          "action": "replace",
          "selection": "hoveredNode"
        }
      ],

      "mark": {
        "type": "text",
        "text": {
          "field": "data[0].source.data._label"
        },
        "x": 150,
        "dy":4,
        "align": "right",
        "fontSize": {
          "expression": "params.labelSizeParam"
        }
      }
    },
    {
      "entries": "groupedBySource",
      "layout": "layout",
      "mark": {
        "type": "symbol",
        "shape": "circle",
        "x": 155,
        "fill": "gray",
        "stroke": "white",
        "area": "40"
      }
    },
    {
      "entries": "groupedBySource",
      "layout": "layout",
      "vis": [
        {
          "entries": "entry.data",
          "mark": {
            "scaling": true,
            "type": "square",
            "fill": {
              "scale": "cellColor",
              "expression": "datum.linkType"
            },
            "opacity": {
              "expression": "((datum.data._time != null && datum.data._time >= params.time[0] && datum.data._time <= params.time[1]) || (datum.data._time == null)) ? 1 : '0' "
            },
            "area": {"parameter": "adjacentLinkSize"},

            "stroke": "#777",
            "strokeWidth": {
              "conditions": [
                {
                  "test": "params.hoveredNode.nodes.length > 0 && datum.target == params.hoveredNode.nodes[0]",
                  "value": 3
                }
              ],
              "value": 0
            },
            "x": {
              "expression": "index * params.spacing + 170"
            },
            "tooltip": {
              "expression": " datum.source.data._label+ ' --- '+ datum.linkType +'--> ' + datum.target.data._label + '' "
            }
          }
        }
      ]
    }
  ]
}